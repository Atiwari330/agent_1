# Deal Agent Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# Required: AI Model Configuration
# ============================================

# OpenAI API Key for GPT-5
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# ============================================
# Required: HubSpot Integration
# ============================================

# HubSpot Private App Access Token
# Get from: Settings → Integrations → Private Apps
# Scopes needed: crm.objects.deals.read, crm.objects.deals.write
HUBSPOT_ACCESS_TOKEN=pat-na1-your-token-here

# ============================================
# Optional: Future Integrations
# ============================================

# Gmail API (Future Phase)
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Google Drive API (Future Phase)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=

# Asana API (Future Phase)
# ASANA_ACCESS_TOKEN=

# ============================================
# Application Configuration
# ============================================

# Environment: development | production
NODE_ENV=development

# Enable verbose logging for debugging
DEBUG=false

# Agent behavior settings
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=30
