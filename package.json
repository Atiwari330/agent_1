{
  "name": "deal-agent",
  "version": "0.1.0",
  "description": "AI-driven agentic workflow for deal management across HubSpot, Gmail, Drive, and Asana",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "deal-agent": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "test-agent": "tsx src/test-agent.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "agent",
    "hubspot",
    "crm",
    "cli",
    "deal-management",
    "vercel-ai-sdk"
  ],
  "author": "Adi Tiwari",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "~1.3.24",
    "@hubspot/api-client": "^11.0.0",
    "ai": "~4.3.19",
    "chalk": "^5.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.0.0",
    "openai": "^4.0.0",
    "ora": "^8.0.0",
    "zod": "^3.22.0",
    "zod-to-json-schema": "^3.24.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
